# Copy this file to .env and fill in real values there. Never put real
# secrets in this file — it's committed to git; .env is gitignored.

# --- SendBlue (iMessage send/receive) ---
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_BASE_URL=https://api.sendblue.co/api
SENDBLUE_FROM_NUMBER=
MY_PHONE_NUMBER=

# --- Meta Model API (Muse Spark) ---
# Get a key at https://dev.meta.ai (Model API dashboard -> API keys -> Create API key)
MODEL_API_KEY=
MUSE_SPARK_MODEL=muse-spark-1.3

# --- Google (Calendar + Places) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
# Separate "Web application" type OAuth client for the per-user browser
# connect flow (app/clients/google_oauth_web.py) -- falls back to
# GOOGLE_CLIENT_ID/SECRET above if unset, but that Desktop-type client's
# localhost-only redirect breaks the moment a real user connects from
# their own phone. Redirect URI to register: WEBHOOK_BASE_URL + /oauth/google/callback
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# --- Database ---
# Supabase (Session pooler, IPv4-safe): postgresql+psycopg2://postgres.<ref>:<url-encoded-password>@<host>.pooler.supabase.com:5432/postgres
# Or, with no setup at all: sqlite:///./stickie.db
DATABASE_URL=

# --- Webhook + frontend (ngrok/cloudflared public URLs while developing) ---
WEBHOOK_BASE_URL=
FRONTEND_BASE_URL=

# Comma-separated real, pre-verified demo numbers, e.g. "+19033063505,+1..."
# Falls back to just MY_PHONE_NUMBER (a 1-person "group") if not set.
DEMO_GROUP_NUMBERS=
